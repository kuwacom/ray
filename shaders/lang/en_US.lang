# Water & reflections
option.WATER_WAVES=Water Waves
option.WATER_WAVE_HEIGHT=Wave Height
screen.WATER_WAVE_OPTIONS=Wave Options (All Water)
screen.WATER_KIND_OPTIONS=Sea / Lake / River
screen.WATER_KIND_OPTIONS.comment=Water settings for each kind of water, in columns: sea, lake, river. The biome the camera is in picks the kind (ocean biomes are sea, river biomes are river, everything else is lake) and changes it smoothly over a few seconds
screen.WATER_GLINT_OPTIONS=Glitter & Reflection Bloom
option.WATER_WAVE_HEIGHT.comment=Multiplier on the wave height given by the wind speed. Applies to all water, on top of the sea / lake / river wave height
option.WATER_WAVE_LENGTH=Wavelength Scale
option.WATER_WAVE_LENGTH.comment=Scales the size of every wave
option.WATER_WIND_SPEED=Sea Wind Speed
