value.DECORATIVE_BLOCK_LIGHTS.2=Light Source
option.LIGHT_SHADOWS=Light Source Shadows
option.LIGHT_SHADOWS.comment=Ray traces the strongest nearby lights so blocks, players and entities cast shadows from placed lights.
option.LIGHT_TRACE_COUNT=Traced Lights per Pixel
option.LIGHT_TRACE_RES=Trace Resolution
