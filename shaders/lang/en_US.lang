value.LIGHT_TRACE_RES.2=Half
value.LIGHT_TRACE_RES.4=Quarter
option.LIGHT_SHAPE_TRACE=Block Shape Occlusion
option.LIGHT_SHAPE_TRACE.comment=Slabs, fences and walls cast shadows with their real shape.
option.LIGHT_SOURCE_SIZE=Light Source Size
option.LIGHT_SOURCE_SIZE.comment=Larger sources give softer shadow edges.
option.LIGHT_TRANSLUCENT_TINT=Stained Glass Tint
option.LIGHT_TRANSLUCENT_TINT.comment=Light passing through stained glass is colored.
option.LIGHT_SPECULAR=Block Light Specular
option.LIGHT_DENOISE=Light Denoiser
