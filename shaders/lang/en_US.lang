value.LIGHT_OCCLUSION_MODE.1=Triangle
option.LIGHT_ENTITY_TRIANGLES=Entity Triangle Limit
option.LIGHT_ENTITY_TRIANGLES.comment=Triangles kept for the Triangle method. 1024 are reserved for your player. Entities beyond the limit fall back to voxel boxes.
option.LIGHT_CONTACT_SHADOWS=Light Contact Shadows
option.LIGHT_CONTACT_SHADOWS.comment=Screen space shadows that add details too small for the voxel grid.
option.HAND_LIGHT=Handheld Light
option.HAND_LIGHT.comment=Holding a light source lights up the surroundings (both hands).
option.HAND_LIGHT_RAYS=Handheld Light Rays
option.HAND_LIGHT_RAYS.comment=Ray traced shadows for handheld lights.
option.HAND_LIGHT_SS_SHADOWS=Handheld Light Contact Shadows
option.HAND_LIGHT_SS_SHADOWS.comment=Screen space shadows from your hand and nearby entities.
option.HAND_LIGHT_BRIGHTNESS=Handheld Light Brightness
option.ENTITY_LIGHTS=Entity Lights
option.ENTITY_LIGHTS.comment=Master switch for dynamic light from entities.
option.ITEM_LIGHTS=Dropped Item Lights
option.ITEM_LIGHTS.comment=Dropped light items (torches, lava buckets...) emit light.
option.PROJECTILE_LIGHTS=Projectile Lights
option.PROJECTILE_LIGHTS.comment=Spectral arrows, fireballs and fireworks emit light.
option.BURNING_ENTITY_LIGHTS=Burning Entity Lights
option.BURNING_ENTITY_LIGHTS.comment=Entities on fire emit light.
option.GLOWING_ENTITY_LIGHTS=Glowing Entity Lights
option.GLOWING_ENTITY_LIGHTS.comment=Blazes, glow squids, magma cubes, end crystals and flashing TNT emit light.

